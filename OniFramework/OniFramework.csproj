    <None Include="mod.yaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="mod_info.yaml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- Same idiom as Directory.Build.props's VerifyGameAssemblies, and for the same
       reason: without it a missing generated file surfaces only as CS0103 naming a type nobody
       wrote by hand, which says nothing about the cause. Version.generated.cs is derived and
       deliberately untracked, so a fresh clone has no copy until build.sh has run once. -->
  <Target Name="VerifyVersionStamped" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(MSBuildThisFileDirectory)Version.generated.cs')"
           Text="Version.generated.cs is missing. It is generated, not tracked; build through build.sh (which writes it from VERSION + git) rather than invoking dotnet build directly." />
  </Target>

</Project>
