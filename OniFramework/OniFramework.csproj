    <Compile Include="FrameGeometry.cs" />
    <Compile Include="RigDiagnostics.cs" />
    <Compile Include="RigCrashScreen.cs" />
    <Compile Include="GasMixtureFacade.cs" />
    <Compile Include="AtmosphereFacade.cs" />
    <Compile Include="ElementChunkFacade.cs" />
    <Compile Include="DebugInspectorServer.cs" />
    <Compile Include="DebugBulkRoutes.cs" />
    <Compile Include="ConduitNetworks.cs" />
    <Compile Include="SimConduitNetworks.cs" />
    <Compile Include="PipeNetworkFacade.cs" />
