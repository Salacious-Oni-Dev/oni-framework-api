<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>OniFramework</RootNamespace>
    <AssemblyName>OniFramework</AssemblyName>
    <!-- Inert: Directory.Build.props sets GenerateAssemblyInfo=false, so no version attribute
         is emitted from this and nothing reads it. The version that actually ships is the one
         build.sh writes into Version.generated.cs from the VERSION file plus git; kept here
         only so a reader who looks for a version in the csproj is sent to the real one. -->
    <Version>0.1.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Version.generated.cs" />
    <Compile Include="BuildStamp.cs" />
    <Compile Include="FrameworkLog.cs" />
    <Compile Include="LoadOrderRepair.cs" />
    <Compile Include="SimDllDelivery.cs" />
    <Compile Include="SimVersion.cs" />
    <Compile Include="GcRuntime.cs" />
    <Compile Include="FrameworkVersion.cs" />
    <Compile Include="RigSaves.cs" />
    <Compile Include="SaveMigrationHandler.cs" />
    <Compile Include="OniExtMessages.cs" />
    <Compile Include="ThermalMassBonus.cs" />
    <Compile Include="MaterialProperties.cs" />
    <Compile Include="ElementRegistry.cs" />
    <Compile Include="DemoNarrator.cs" />
    <Compile Include="HoverCard.cs" />
    <Compile Include="DemoRig.cs" />
    <Compile Include="RigHarness.cs" />
    <Compile Include="RigRegistry.cs" />
    <Compile Include="RigBlueprint.cs" />
    <Compile Include="BlueprintDump.cs" />
